<Window x:Class="TechTrack.View.RegisterForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechTrack.View"
        mc:Ignorable="d"
        Title="Register User" Height="500" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- First Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding FirstNameError}" Foreground="Red"/>

        <!-- Last Name -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LastNameError}" Foreground="Red"/>

        <!-- Phone Number -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone Number:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding PhoneNumberError}" Foreground="Red"/>

        <!-- Email -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding EmailError}" Foreground="Red"/>

        <!-- Role -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Role:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox Grid.Row="8" Grid.Column="1" SelectedValue="{Binding Role}" Width="200" Margin="0,0,0,10">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="Employee"/>
        </ComboBox>

        <!-- Username -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="{Binding UsernameError}" Foreground="Red"/>

        <!-- Password -->
        <TextBlock Grid.Row="11" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <PasswordBox Grid.Row="11" x:Name="PasswordBox"  Grid.Column="1" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="{Binding PasswordError}" Foreground="Red"/>

        <!-- Confirm Password -->
        <TextBlock Grid.Row="13" Grid.Column="0" Text="Confirm Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <PasswordBox Grid.Row="13" x:Name="ConfirmPasswordBox" Grid.Column="1" Width="200" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Text="{Binding ConfirmPasswordError}" Foreground="Red"/>

        <!-- Submit Button -->
        <Button Grid.Row="15" Grid.Column="1" Content="Register" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Command="{Binding RegisterButton}"/>
    </Grid>
</Window>
