<Window x:Class="TechTrack.View.Admin.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechTrack.View.Admin"
        mc:Ignorable="d"
        Title="AdminMainWindow" Height="800" Width="1520" WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Grid.Row="0" Height="177" Width="177"></Image>
        <Button Grid.Column="1" Grid.Row="0" BorderThickness="0" Height="100" Width="150" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 30 20 0">
            <Button.Content>
                <StackPanel Orientation="Vertical">
                    <Grid Width="60" Height="60">

                    </Grid>
                    <Label x:Name="Username" FontSize="18" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button.Content>
        </Button>
       
        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" BorderThickness="0 0 0 1" BorderBrush="Black"/>
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderThickness="0 0 1 0" BorderBrush="Black"/>
        <Frame x:Name="mainFrame" NavigationUIVisibility="Hidden" Grid.ColumnSpan="3" Grid.RowSpan="2"></Frame>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Height="110" Width="320" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Content>
                    <Label Content="Product Management" FontSize="25" Margin="10 0 0 0"></Label>
                </Button.Content>
            </Button>
            <Button Grid.Row="1" Height="110" Width="320" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Content>
                    <Label Content="Supplier Management" FontSize="25" Margin="10 0 0 0"></Label>
                </Button.Content>
            </Button>
            <Button  Grid.Row="2" Height="110" Width="320" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Content>
                    <Label Content="Order Management" FontSize="25" Margin="10 0 0 0"></Label>
                </Button.Content>
            </Button>
            <Button  Grid.Row="3" Height="110" Width="320" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Content>
                    <Label Content="Reports" FontSize="25" Margin="10 0 0 0"></Label>
                </Button.Content>
            </Button>
            <Border Grid.Row="4" Grid.Column="0" BorderThickness="0 1 0 0" Margin="0 15 0 0" BorderBrush="Black"/>
            <Grid Grid.Row="4" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Margin="0 20 0 0"  Grid.Column="0" Height="60" Width="150" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                           
                            <Label Content="Log Out" FontSize="20"></Label>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
