<Page x:Class="TechTrack.View.Admin.OrderManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TechTrack.View.Admin"
      xmlns:local1="clr-namespace:TechTrack.Helpers.Converters"
      xmlns:local2="clr-namespace:TechTrack.Helpers"
      mc:Ignorable="d" 
       d:DesignHeight="800" d:DesignWidth="1520"
      Title="OrderManagementPage">
    <Page.Resources>
        <local1:SupplierIdToSupplierName x:Key="SupplierIdToSupplierName"/>
        <local1:OrderItemsConverter x:Key="OrderItemsConverter"/>
        <local1:ProductIdToProductName x:Key="ProductIdToProductName"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="1" Content="Order Management" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20 0 0 0" FontWeight="Medium" FontSize="40"/>
        <Grid Grid.Row="1" Grid.Column="1" Background="#DDDDDD" Focusable="True" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="42 0 0 0" HorizontalAlignment="Left" Height="80" Width="auto" Background="WhiteSmoke" CornerRadius="15">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CreatePurchaseOrderButton" Content="Create Purchase Order" Width="200" Height="45" Margin="20 0 10 0" BorderThickness="0" VerticalAlignment="Center" FontSize="18" Click="PButtonClick" ></Button>
                    <Button x:Name="CreateUserOrderButton" Content="Create User Order" Width="200" Height="45" Margin="0 0 20 0" BorderThickness="0"  VerticalAlignment="Center" FontSize="18" Click="UButtonClick"   ></Button>
                </StackPanel>
            </Border>
            <ListBox Name="ProductListBox" ItemsSource="{Binding Products, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Grid.Row="1" Margin="10" SelectionChanged="ProductListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding Price, StringFormat='{}{0} EUR'}" FontStyle="Italic"/>
                            <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                <TextBlock Text="Selected Product for Purchase Order:" FontWeight="Bold"/>
                <TextBlock Name="SelectedProductTextBlock" Margin="0,5,0,15"/>

                <TextBlock Text="Quantity:"/>
                <TextBox Name="QuantityTextBox" Width="100" Margin="0,5,0,15"/>

                <Button Name="AddToOrderButton" Content="Add to Order" Command="{Binding AddItem}" Margin="0,5,0,15"/>

                <TextBlock Text="Order Items:" FontWeight="Bold" Margin="0,15,0,5"/>
                <ListBox Name="OrderItemsListBox" ItemsSource="{Binding AddProducts, UpdateSourceTrigger=PropertyChanged}" Height="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0} EUR'}" FontStyle="Italic"/>
                                <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Total Price:" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBlock Name="TotalPriceTextBlock" Text="0.00" FontWeight="Normal"/>

                <Button Name="CreateOrderButton" Content="Create Order" Command="{Binding CreateOrder}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <ComboBox Name="StatusComboBox" Width="150" Height="30" Margin="0,0,10,0"
              ItemsSource="{Binding OrderStatusList}"
              SelectedItem="{Binding SelectedOrderStatus, Mode=TwoWay}" />

                <Button Content="Update Status" Width="120" Height="30" 
            Command="{Binding UpdateOrderStatusCommand}"
            Margin="5,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="2" Margin="10">
                <ListView ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock Text="{Binding IdOrder}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CreationDate}"/>
                                <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="Gray"/>

                                <ListView ItemsSource="{Binding IdOrder, Converter={StaticResource OrderItemsConverter}}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Margin="5">
                                                <TextBlock>
                                                    <Run Text="Product Name: " />
                                                    <Run Text="{Binding ProductId, Converter={StaticResource ProductIdToProductName}}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="Quantity: " />
                                                    <Run Text="{Binding Quantity}" />
                                                </TextBlock>

                                                <TextBlock>
                                                    <Run Text="Total Price: " />
                                                    <Run Text="{Binding TotalPrice, StringFormat='{}{0} EUR'}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
