<Page x:Class="TechTrack.View.Admin.ManageProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TechTrack.View.Admin"
      xmlns:local1="clr-namespace:TechTrack.Helpers.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1520"
      Title="ManageProductsPage">
    <Page.Resources>
        <local1:SupplierIdToSupplierName x:Key="SupplierIdToSupplierName"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="1" Content="Product Management" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20 0 0 0" FontWeight="Medium" FontSize="40"/>
        <Grid Grid.Row="1" Grid.Column="1" Background="#DDDDDD" Focusable="True" x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="42 0 0 0" HorizontalAlignment="Left" Height="80" Width="450" Background="WhiteSmoke" CornerRadius="15">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddProductButton" Content="Add New Products" Width="200" Height="45" Margin="20 0 10 0" BorderThickness="0"  VerticalAlignment="Center" FontSize="18" Click="AddProductButton_Click"   ></Button>
                    <Button x:Name="ManageProductButton" Content="Manage Products" Width="200" Height="45" Margin="0 0 10 0" BorderThickness="0" VerticalAlignment="Center" FontSize="18" Click="ManageProductButton_Click" ></Button>
                </StackPanel>
            </Border>
            <TextBox Name="searchTxtBox" Grid.Row="1" Grid.Column="0" Height="30" FontSize="20" Width="120" Margin="10 0 5 0" HorizontalAlignment="Left"></TextBox>
            <Button Grid.Column="0" Grid.Row="1" Content="Search" Command="{Binding SearchButton}" FontSize="20" Height="30" Width="80" Margin="0 0 50 0" HorizontalAlignment="Center"></Button>
            <Button Grid.Column="0" Grid.Row="1" Content="Availabe" Command="{Binding AvailabeButton}" FontSize="20" Height="30" Width="80" HorizontalAlignment="Center" Margin="132 0 5 0"></Button>
            <Button Grid.Column="0" Grid.Row="1" Content="Delete" Command="{Binding DeleteButton}" FontSize="20" Height="30" Width="80" HorizontalAlignment="Right" Margin="0 0 5 0"></Button>
            <DataGrid x:Name="ProductsDataGrid"  SelectedItem="{Binding SelectedProductId}" SelectedValuePath="Id" ItemsSource="{Binding Products, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" />
                    <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierId, Converter={StaticResource SupplierIdToSupplierName}}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Margin="20">
                <TextBlock Text="Update Product" FontWeight="Bold" FontSize="30" Margin="0 0 0 5"/>

                <TextBlock Text="Name:" FontSize="18"/>
                <TextBox x:Name="ProductNameTextBox" Width="200" Height="25" Margin="0 0 0 5" HorizontalAlignment="Left"
                    Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding ProductNameError}" Foreground="Red" FontSize="12" Margin="0 0 0 5"/>

                <TextBlock Text="Description:" FontSize="18"/>
                <TextBox x:Name="ProductDescriptionTextBox" Width="200" Height="45" Margin="0 0 0 5" HorizontalAlignment="Left"
                    Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding DescriptionError}" Foreground="Red" FontSize="12" Margin="0 0 0 5"/>

                <TextBlock Text="Quantity:" FontSize="18"/>
                <TextBox x:Name="ProductQuantityTextBox" Width="200" Height="25" Margin="0 0 0 5" HorizontalAlignment="Left"
                    Text="{Binding ProductQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding QuantityError}" Foreground="Red" FontSize="12" Margin="0 0 0 5"/>

                <TextBlock Text="Price:" FontSize="18"/>
                <TextBox x:Name="ProductPriceTextBox" Width="200" Height="25" Margin="0 0 0 5" HorizontalAlignment="Left"
                    Text="{Binding ProductPrice, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding PriceError}" Foreground="Red" FontSize="12" Margin="0 0 0 5"/>

                <TextBlock Text="Supplier Name:" FontSize="18"/>
                <ComboBox x:Name="SupplierComboBox" ItemsSource="{Binding Suppliers, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="25" Margin="0 0 0 5"
                    HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" 
                    SelectedItem="{Binding SelectedSupplierId}"/>       
                <Button x:Name="SubmitProductButton" Command="{Binding SubmitCommand}" FontSize="20" Content="Submit" Width="200" HorizontalAlignment="Left" Height="40" Margin="0 10 0 0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
                <ComboBox x:Name="MinPriceComboBox" Width="100" Height="30" Margin="20 0 0 0"
                  ItemsSource="{Binding PriceOptions}" 
                  SelectedItem="{Binding SelectedMinPrice}"  />
                <ComboBox x:Name="MaxPriceComboBox" Width="100" Height="30" Margin="20 0 0 0"
                  ItemsSource="{Binding MaxPriceOptions}" 
                  SelectedItem="{Binding SelectedMaxPrice}"  />
                <Button Content="Filter" Command="{Binding FilterByPriceCommand}" Margin="20 0 0 0" Width="100" Height="30" FontSize="20" />
             </StackPanel>
        </Grid>
    </Grid>
</Page>
